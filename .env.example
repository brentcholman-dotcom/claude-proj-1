# Flask Secret Key (REQUIRED - Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))')
# NEVER commit your actual SECRET_KEY to git!
SECRET_KEY=your_secret_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000

# LLM Provider API Keys (Optional - keys are stored in encrypted sessions)
# Only needed if you want to pre-configure a provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# CORS Configuration (REQUIRED for production)
# Comma-separated list of allowed origins
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5000

# Redis Configuration (for session storage)
# Option 1: Full Redis URL (recommended)
REDIS_URL=redis://:your_redis_password@localhost:6379/0
# Option 2: Individual settings (alternative)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0

# Session Configuration
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_DOMAIN=  # Set your domain in production
